# ── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dukaplus.db
# Railway PostgreSQL (auto-set when you link a Postgres plugin):
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Security (REQUIRED in production) ─────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_DAYS=3
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS — add your frontend URL(s) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production
# SEED_DEMO_DATA=false

# ── Super Admin (created on first startup if missing) ─────────────────────────
SUPER_ADMIN_EMAIL=admin@dukaplus.co.tz
SUPER_ADMIN_PASSWORD=change-me-in-production
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_PHONE=+255700000001

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — do not hardcode in production
PORT=8000

# ── Optional ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
CACHE_TTL_SECONDS=30
ANALYTICS_CACHE_TTL_SECONDS=60
REDIS_URL=
SEED_DEMO_DATA=true
