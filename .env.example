# ── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dukaplus.db

# Railway — on your BACKEND service Variables tab, add:
# DATABASE_URL=${{ Postgres.DATABASE_PRIVATE_URL }}
# (Use your Postgres service name if not "Postgres", e.g. ${{ postgres.DATABASE_PRIVATE_URL }})
# Private URL is recommended: faster + stays inside Railway network.
# Public alternative: DATABASE_URL=${{ Postgres.DATABASE_URL }}

# ── Security (REQUIRED in production) ─────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_DAYS=3
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS — comma-separated exact origins (optional; regex also allows *.vercel.app & *.dukadigital.co.tz) ──
# CORS_ORIGINS=http://localhost:5173,https://www.dukadigital.co.tz,https://dukadigital.co.tz
# Do not set CORS_ORIGINS=* — use explicit URLs. If you set CORS_ORIGINS on Railway, include every live frontend URL.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production
SEED_DEMO_DATA=true

# ── Super Admin (created on first startup if missing) ─────────────────────────
SUPER_ADMIN_EMAIL=admin@dukaplus.co.tz
# Local dev: admin123. Production: set a strong secret on Railway/host.
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_PHONE=+255700000001

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically — do not hardcode in production
PORT=8000

# ── ClickPesa (subscription M-Pesa / mobile money push) ───────────────────────
# Required for in-app subscription checkout + webhooks (set on Railway backend only).
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_SECRET=
# Must match ClickPesa dashboard checksum key when checksum is enabled.
# Optional override (default includes /third-parties):
# CLICKPESA_API_BASE=https://api.clickpesa.com/third-parties
# If Railway cannot reach ClickPesa (connect timeout), use a TZ HTTPS proxy:
# CLICKPESA_HTTPS_PROXY=http://user:pass@your-vps:3128
# CLICKPESA_CONNECT_TIMEOUT_SECONDS=45
# Webhook URL (ClickPesa dashboard): https://YOUR-BACKEND/api/v1/webhooks/clickpesa
# Diagnostics after deploy: GET https://YOUR-BACKEND/api/health/clickpesa

# ── Optional ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
CACHE_TTL_SECONDS=30
ANALYTICS_CACHE_TTL_SECONDS=60
REDIS_URL=
SEED_DEMO_DATA=true
